MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: DialogueTable_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: d3c70e1c15463004ab983a0d87864bb3, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 2201622364020736
    m_Localized: <I>...No.
    m_Metadata:
      m_Items: []
  - m_Id: 2201622364020738
    m_Localized: <I>Got it.
    m_Metadata:
      m_Items: []
  - m_Id: 2201622364020740
    m_Localized: <I>Yeah.
    m_Metadata:
      m_Items: []
  - m_Id: 2201622364020742
    m_Localized: <I>Yeah.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416064
    m_Localized: <I>No. I put it in the mailbox.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416066
    m_Localized: <I>No.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416068
    m_Localized: <Voice on Phone>...Was it delivered?
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416069
    m_Localized: <I>Who is this?
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416071
    m_Localized: <I>I do not know. They did not say anything.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416073
    m_Localized: <I>Why?
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416076
    m_Localized: <Postmaster>You left the package by the door?
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416078
    m_Localized: <Postmaster>...#Did it take it?
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416080
    m_Localized: <Postmaster>Good. You were not supposed to.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416082
    m_Localized: <I>There is something in the back-room locker.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416084
    m_Localized: <I>Then what does it want?
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416085
    m_Localized: <Postmaster>I know.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416087
    m_Localized: <Postmaster>You left it open too long.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416089
    m_Localized: <Postmaster>...#For signing receipts.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416091
    m_Localized: <Postmaster>...#Tomorrow is your last day. Once the delivery is
      done, it is no longer your concern.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416093
    m_Localized: <Postmaster>You will ask again tomorrow. Go to sleep.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416095
    m_Localized: <Postmaster>Then it will come remind you.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416099
    m_Localized: <I>The alarm did not go off.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416101
    m_Localized: <I>Do I still have to make deliveries today?
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416103
    m_Localized: <I>What do you mean, one last time?
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416105
    m_Localized: <I>What is the right one?
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416107
    m_Localized: <I>The bag is empty.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416109
    m_Localized: <I>Then what am I supposed to deliver?
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416111
    m_Localized: <I>I am asking what goes inside.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416113
    m_Localized: <I>I am not going.
    m_Metadata:
      m_Items: []
  - m_Id: 6119307011416115
    m_Localized: <I>Hey, kid. Pay attention when I am talking.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708230438912
    m_Localized: <Postmaster>Hey, kid. Pay attention when I am talking.#Did you understand
      what I just told you?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216128
    m_Localized: <Postmaster>Fine. I will say it again.#You are responsible for addresses
      400 through 410. Make deliveries before dawn and collect items in the evening.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216129
    m_Localized: <Postmaster>You are back?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216130
    m_Localized: <Postmaster>Did you deliver to 410?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216131
    m_Localized: <Postmaster>Did it open the door?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216132
    m_Localized: <Postmaster>Good.#...#The letter was not damaged, was it?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216133
    m_Localized: <Postmaster>Mm. Get some sleep. You will be collecting things this
      evening.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216134
    m_Localized: <Postmaster>Who called?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216135
    m_Localized: <Postmaster>...#Do not answer the phone at night.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216136
    m_Localized: <Postmaster>No need.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216137
    m_Localized: <Postmaster>Done?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216138
    m_Localized: <I>Yeah.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216139
    m_Localized: <I>...I do not know. I could not see clearly.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216140
    m_Localized: <I>What is 410, exactly?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216141
    m_Localized: <Voice on Phone>The package you left by the door this morning is
      not what it wanted.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216142
    m_Localized: <I>You know?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216143
    m_Localized: <I>That hand... what was it?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216144
    m_Localized: <I>What exactly has 410 been making us deliver?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708247216145
    m_Localized: <I>What do you mean, my last day?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187648
    m_Localized: <I>What if I do not?
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187649
    m_Localized: <Postmaster>Do not answer it.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187650
    m_Localized: <Postmaster>It already knows you heard it.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187651
    m_Localized: <Postmaster>You overslept.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187652
    m_Localized: <Postmaster>It is fine. They will wait.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187653
    m_Localized: <Postmaster>One last time.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187654
    m_Localized: <Postmaster>None of the things before were what it wanted.#Today,
      you will deliver the right one.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187655
    m_Localized: <Postmaster>...#Go to the back room. Open locker 410. There is only
      one item left inside.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187656
    m_Localized: <Postmaster>Mm.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187657
    m_Localized: <Postmaster>Deliver it the same way you always do.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187658
    m_Localized: <Postmaster>When you reach 410, you will know.
    m_Metadata:
      m_Items: []
  - m_Id: 6566708268187659
    m_Localized: <Postmaster>Then it will come to the post office and collect it.
      You do not have a choice.
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
