MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: SubtitleTable_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 61765522672862a4e97c9c73ab99cdc1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1753140243193856
    m_Localized: Maybe I should get some rest.<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136896
    m_Localized: Time to make the deliveries.<2>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136897
    m_Localized: Was this here before?<2>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136898
    m_Localized: It is raining.<1.5>#I had better hurry.<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136899
    m_Localized: Oh no. I need to pick up the letter.<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136900
    m_Localized: I am just checking the damage.<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136901
    m_Localized: ...It fell out on its own.<2.5>#I had to make sure it was okay.<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136902
    m_Localized: What the hell?<1.5>#It even mentions what happened yesterday?<3>#How
      did it know I would fall?<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136903
    m_Localized: Is this from my point of view?<2.5>#But I have not delivered the
      letter yet.<3>#This photo... was taken later?<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136904
    m_Localized: No sound from inside.<2>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136905
    m_Localized: Who put this here?<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136906
    m_Localized: Why did he ask that?<2>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136907
    m_Localized: Special handling for 410 again?<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136908
    m_Localized: What is inside?<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136909
    m_Localized: Is that a handprint?<2>#Who pushed it out through the mailbox?<3>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136910
    m_Localized: I should close the locker first.<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136911
    m_Localized: Did that sound come from the back room?<3>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136912
    m_Localized: Rest?<1.5>#After that package yesterday... and 410? No way I can
      sleep.<4.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136913
    m_Localized: No one lives there...<2>#Then who have I been delivering to?<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 1753140285136914
    m_Localized: The old mail carrier asked about 410 too...<3.5>#Every time a new
      mail carrier comes, the old one disappears?<4.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353589161984
    m_Localized: The door never opened, but the package vanished...<4>#Then who took
      it?<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522112
    m_Localized: If I have to deliver another package to 410...<3.5>#I need to take
      a look.<2>#Just from a distance.<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522113
    m_Localized: Separate handling for 410 again.<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522114
    m_Localized: Was someone there?<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522115
    m_Localized: This again.<1.5>#Was the package from the forum like this too?<3.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522116
    m_Localized: d3Is that a handprint?<2>#d3Who pushed it out through the mailbox?<3>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522117
    m_Localized: Were these marks here before?<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522118
    m_Localized: ...Something must have slipped down inside.<3.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522119
    m_Localized: No.<1>#That is not something sliding down.<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522120
    m_Localized: Do not confirm who takes it?<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522121
    m_Localized: I am not even at 410 yet...<2.5>#It already knows what I am delivering?<3>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522122
    m_Localized: It really took it...<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522123
    m_Localized: I will not get close.<2>#Just one look.<1.5>#Let us see who comes
      to take it.<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522124
    m_Localized: Was that... a hand?<2>#The door never opened.<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522125
    m_Localized: I should not have looked.<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522126
    m_Localized: What does he mean, do not leave the locker open too long?<4>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522127
    m_Localized: Not this?<1.5>#Then what does it want?<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522128
    m_Localized: That did not sound like something sliding down.<3.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522129
    m_Localized: It is so quiet today.<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522130
    m_Localized: Nothing for 410?<1.5>#Why point that out?<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522131
    m_Localized: An item for a different address?<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522132
    m_Localized: One last thing?<1.5>#Not a letter, not a package... then what else
      could it be?<4.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522133
    m_Localized: Was it delivered to the wrong house?<3>#It does not want this.<2>#But
      it wants me to bring it back?<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522134
    m_Localized: What is it waiting for?<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522135
    m_Localized: This package should belong to 410.<2.5>#But it was at 404.<1.5>#I
      will put it in the back-room locker for now.<3.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522136
    m_Localized: It came out of here?<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522137
    m_Localized: I need to see what is inside.<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522138
    m_Localized: I need to find the postmaster.<2.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522139
    m_Localized: What is still missing?<2>#Bring it tomorrow?<1.5>#Who is bringing
      it?<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522140
    m_Localized: The alarm did not go off.<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522141
    m_Localized: Empty?<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522142
    m_Localized: Is this... the front desk?<2.5>#Who is that?<1.5>#Why is this photo
      here?<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522143
    m_Localized: Final item?<1.5>#But there is nothing inside.<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522144
    m_Localized: I cannot turn back.<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522145
    m_Localized: The bag is moving.<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522146
    m_Localized: Approaching?<1.5>#What is approaching?<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522147
    m_Localized: The mail carrier...?<2>#No. That is not right.<2>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522148
    m_Localized: Recipient confirmation?<2>#This is not asking me to deliver something...<3.5>#It
      is collecting me.<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6119353618522149
    m_Localized: New manager?<1.5>
    m_Metadata:
      m_Items: []
  - m_Id: 6566433608384512
    m_Localized: I should answer the phone.<2>
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
